{
  "name": "@elzup/kit",
  "version": "4.5.0",
  "description": "elzup&#39;s utils",
  "access": "public",
  "license": "MIT",
  "repository": "elzup/kit-js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "yarn build:cjs && yarn build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/mark-esm.mts",
    "deploy": "npx npm@latest publish",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "prettier --check 'src/**/*.{ts,tsx}' '*.md'",
    "format:fix": "prettier --write 'src/**/*.{ts,tsx}' '*.md'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:badges": "yarn test:cov && istanbul-badges-readme",
    "mutation": "mutator",
    "mutation:diff": "mutator --since main --fail-on-survived",
    "prepare": "husky",
    "depcruise": "depcruise --config .dependency-cruiser.js --include-only '^src' --output-type dot src | dot -T svg > dependencygraph.svg",
    "check:dist": "node scripts/check-dist.mts",
    "prepublishOnly": "yarn test && yarn build && yarn check:dist"
  },
  "lint-staged": {
    "*.{ts,json,md}": [
      "git add"
    ]
  },
  "exports": {
    "./*": {
      "types": "./lib/*.d.ts",
      "import": "./lib/esm/*.js",
      "require": "./lib/*.js",
      "default": "./lib/*.js"
    }
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "utils",
    "personal"
  ],
  "devDependencies": {
    "@elzup/tsconfig": "1.1.0",
    "@mizchi/mutator": "^0.4.5",
    "@types/node": "24.9.2",
    "@vitest/coverage-istanbul": "^5.1.1",
    "dependency-cruiser": "17.2.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.6",
    "oxlint": "^1.25.0",
    "prettier": "^3.6.2",
    "tsd": "0.33.0",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
